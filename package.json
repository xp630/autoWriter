{
  "name": "autowriter-desktop",
  "version": "0.1.0",
  "description": "autoWriter 桌面版 — Electron + React + TS，仿 autosocialX 布局",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "package": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",

    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ipc": "playwright test tests/e2e/ipc-registry.spec.ts tests/e2e/ipc-handlers.spec.ts",
    "test:e2e:ui": "playwright test tests/e2e/ui-smoke.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "i18next": "^23.12.0",
    "image-size": "^2.0.2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.1",
    "marked": "^18.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "tams-sdk": "^1.0.0",
    "turndown": "^7.2.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.0",
    "wait-on": "^7.2.0"
  }
}
