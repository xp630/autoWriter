{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist-electron",
    "rootDir": "./electron",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.cjs"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}